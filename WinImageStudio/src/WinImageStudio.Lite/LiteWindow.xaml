<Window x:Class="WinImageStudio.Lite.LiteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinImageStudio Lite" Width="980" Height="760" MinWidth="820" MinHeight="620" Background="#0D1117" Foreground="#EDF3FC" FontFamily="Segoe UI" FontSize="15" FlowDirection="RightToLeft" Closing="ClosingWindow">
<DockPanel Margin="24">
 <StackPanel DockPanel.Dock="Top"><TextBlock Text="WinImageStudio Lite" FontSize="30" FontWeight="Bold"/><TextBlock Text="0.7.0 · تخفيف قوي تلقائي لجميع إصدارات Windows 10/11 Client" Foreground="#8FB8D9"/><TextBlock x:Name="StatusText" Text="اختر ISO الأصلي ثم اضغط التالي." Margin="4,16,4,8"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="7" Height="5" Margin="4,4,4,14"/></StackPanel>
 <Expander DockPanel.Dock="Bottom" Header="السجل التفصيلي" Foreground="#AAB7C8" Margin="0,8"><TextBox x:Name="LogBox" Height="130" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
 <Border DockPanel.Dock="Bottom" Background="#161B22" CornerRadius="8" Padding="12" Margin="0,16,0,0"><DockPanel><Button x:Name="NextButton" Content="التالي — اختيار الإصدار" Click="Next" MinWidth="230" Background="#16775E" DockPanel.Dock="Left"/><Button x:Name="CancelButton" Content="إيقاف بعد الخطوة الحالية" Click="Cancel" Visibility="Collapsed" DockPanel.Dock="Left"/><TextBlock x:Name="FooterHint" Text="ملف Windows الأصلي يبقى محفوظًا." VerticalAlignment="Center"/></DockPanel></Border>
 <Border Background="#161B22" CornerRadius="8" Padding="18"><Grid>
  <StackPanel x:Name="SourcePage"><TextBlock Text="① اختر ملف Windows" FontSize="24" FontWeight="Bold"/><DockPanel><Button x:Name="BrowseButton" Content="اختيار ISO" Click="BrowseSource" DockPanel.Dock="Left"/><TextBox x:Name="SourceBox" TextChanged="Changed"/></DockPanel><TextBlock Text="المسار الوحيد: التخفيف القوي" FontWeight="Bold" Margin="4,20,4,8"/><TextBlock Text="بعد اختيار الإصدار، ينفذ البرنامج التحليل والتخفيف والحفظ وضغط ESD وبناء ISO تلقائيًا. يحافظ على الطباعة والمتجر واللغتين العربية والإنجليزية الموجودة في المصدر. المكونات المحمية قد تبقى ويظهر ذلك في التقرير."/>
   <Expander Header="مكان الحفظ والمتابعة · اختياري" Foreground="#AAB7C8" Margin="4,18"><StackPanel><TextBlock Text="مجلد النتيجة · يستخدم اسم ISO جديدًا تلقائيًا"/><DockPanel><Button Content="اختيار مجلد" Click="BrowseOutput" DockPanel.Dock="Left"/><TextBox x:Name="OutputFolderBox"/></DockPanel><Button x:Name="OpenProjectButton" Content="متابعة مشروع Lite سابق" Click="OpenProject"/></StackPanel></Expander>
  </StackPanel>
  <StackPanel x:Name="EditionPage" Visibility="Collapsed"><TextBlock Text="② اختر الإصدار ثم ابدأ" FontSize="24" FontWeight="Bold"/><ComboBox x:Name="EditionBox" DisplayMemberPath="ImageName" SelectionChanged="Changed"/><Button x:Name="EditionBackButton" Content="اختيار ISO آخر" Click="NewSource"/><TextBlock x:Name="ProjectText" Foreground="#8FB8D9" FontSize="12"/><TextBlock Text="بالضغط على التالي تبدأ عملية التخفيف القوي كاملة، وتُجهز أدوات ADK المرفقة على جهازك عند الحاجة. قد يلزم الإنترنت لمكونات ADK. لا تحتاج إلى تطبيق أو حفظ أو إنشاء ISO يدويًا." Margin="4,18"/><TextBlock Text="اختر Home أو Pro أو Education أو Enterprise أو LTSC أو أي إصدار Client مدعوم موجود داخل ISO. لا تُعدّل النسخة الأصلية." Foreground="#AAB7C8"/>
  </StackPanel>
  <StackPanel x:Name="ProcessingPage" Visibility="Collapsed"><TextBlock Text="جارٍ تجهيز النسخة تلقائيًا" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="StepsText" FontSize="18" Margin="4,18"/><TextBlock Text="قد يستغرق الضغط والحفظ وقتًا. الإيقاف يُلاحظ بين الخطوات ولا يقتل DISM أثناء العمل." Foreground="#AAB7C8"/></StackPanel>
  <Grid x:Name="DonePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="✓ النسخة جاهزة" FontSize="28" FontWeight="Bold" Foreground="#65D6A6"/><TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock x:Name="SizeText" Grid.Row="2"/><TextBox x:Name="ResultText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft" Foreground="#F5C778"/><WrapPanel Grid.Row="4"><Button Content="تخفيف نسخة أخرى" Click="NewSource"/><TextBlock Text="اختبر ISO في جهاز افتراضي قبل تثبيته." VerticalAlignment="Center"/></WrapPanel></Grid>
  <StackPanel x:Name="ErrorPage" Visibility="Collapsed"><TextBlock Text="لم تكتمل المهمة" FontSize="24" FontWeight="Bold" Foreground="#F5C778"/><TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="190" FlowDirection="RightToLeft"/><TextBlock x:Name="RecoveryHint"/><Button x:Name="RecoverButton" Content="استعادة الجلسة المتعثرة وإعادة المحاولة" Click="Recover" Visibility="Collapsed"/><Button x:Name="RetryButton" Content="إعادة المحاولة" Click="Retry"/><Button Content="تغيير مكان حفظ النتيجة" Click="BrowseOutput"/><Button x:Name="ErrorNewButton" Content="الرجوع لاختيار مصدر جديد" Click="NewSource"/><TextBlock Text="المصدر الأصلي محفوظ. لا تحذف مجلد مشروع ما زال يحتوي صورة مركبة." Foreground="#8FB8D9"/></StackPanel>
 </Grid></Border>
</DockPanel></Window>
