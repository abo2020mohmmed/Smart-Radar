<Window x:Class="WinImageStudio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinImageStudio — Windows Image Workshop" Width="1150" Height="820" MinWidth="900" MinHeight="650" FlowDirection="RightToLeft" Closing="WindowClosing" Background="#0D1117" Foreground="#EDF3FC" FontFamily="Segoe UI" FontSize="14">
<DockPanel Margin="20">
 <StackPanel DockPanel.Dock="Top">
  <DockPanel><TextBlock Text="WinImageStudio" FontSize="26" FontWeight="Bold"/><TextBlock Text="0.4.0 · معالج تخصيص Windows" VerticalAlignment="Center" Foreground="#8FB8D9"/></DockPanel>
  <UniformGrid Columns="5" Margin="0,10"><TextBlock x:Name="Step1"/><TextBlock x:Name="Step2"/><TextBlock x:Name="Step3"/><TextBlock x:Name="Step4"/><TextBlock x:Name="Step5"/></UniformGrid>
  <Border Background="#161B22" CornerRadius="8" Padding="10"><StackPanel><TextBlock x:Name="SessionLabel" Text="لا يوجد مشروع مفتوح" FontSize="12" MaxHeight="45"/><DockPanel><Button x:Name="CancelButton" Content="إيقاف بعد الخطوة الحالية" Click="CancelClick" IsEnabled="False" DockPanel.Dock="Left"/><TextBlock x:Name="StatusLabel" Text="جاهز" VerticalAlignment="Center"/></DockPanel><ProgressBar x:Name="Progress" Height="4"/></StackPanel></Border>
 </StackPanel>
 <Expander DockPanel.Dock="Bottom" Header="السجل التفصيلي · اختياري" Margin="0,6" Foreground="#AAB7C8"><TextBox x:Name="LogBox" Height="130" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
 <Border DockPanel.Dock="Bottom" Background="#161B22" Padding="12" CornerRadius="8" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GuideText" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="BackButton" Content="السابق" Click="PreviousStep" MinWidth="90"/><Button Grid.Column="2" x:Name="NextButton" Content="التالي" Click="NextStep" Background="#16775E" MinWidth="220" FontWeight="Bold"/></Grid></Border>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,14,0,8"><TextBlock x:Name="PageTitle" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="PageDescription" Foreground="#AAB7C8"/></StackPanel>
 <TabControl x:Name="EditorTabs" Grid.Row="1"><TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="#161B22" CornerRadius="8" Padding="12"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate></TabControl.Template>
 <TabItem x:Name="SourceTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="المسار" FontWeight="Bold"/><WrapPanel><RadioButton x:Name="StrongMode" GroupName="Mode" Content="التخفيف القوي · Windows Pro" IsChecked="True" Checked="ModeChanged" Margin="12,8"/><RadioButton x:Name="ManualMode" GroupName="Mode" Content="التخصيص اليدوي" Checked="ModeChanged" Margin="12,8"/></WrapPanel>
  <TextBlock Text="ملف Windows الأصلي · يفضل ISO لإنشاء نسخة نهائية قابلة للإقلاع"/><DockPanel><Button x:Name="SourceBrowse" Content="اختيار ملف" Click="BrowseSource" DockPanel.Dock="Left"/><TextBox x:Name="SourceBox" TextChanged="WizardInputChanged"/></DockPanel>
  <TextBlock Text="مجلد العمل · سيُنشأ مشروع مستقل ويحفظ المصدر الأصلي"/><DockPanel><Button x:Name="WorkspaceBrowse" Content="اختيار مجلد" Click="BrowseWorkspace" DockPanel.Dock="Left"/><TextBox x:Name="WorkspaceBox" TextChanged="WizardInputChanged"/></DockPanel>
  <Button x:Name="OpenProjectButton" Content="أو فتح مشروع سابق والمتابعة من آخر خطوة" Click="OpenProject"/>
  <Expander Header="متقدم · استيراد أجزاء SWM" Foreground="#AAB7C8" Margin="8"><StackPanel><TextBlock Text="حدد wimlib-imagex.exe فقط إذا كان المصدر SWM. تطبق الإعدادات عند الضغط على التالي."/><DockPanel><Button Content="اختيار الأداة" Click="BrowseWimlib" DockPanel.Dock="Left"/><TextBox x:Name="WimlibBox"/></DockPanel></StackPanel></Expander>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem x:Name="PrepareTab"><StackPanel><TextBlock Text="الإصدار"/><ComboBox x:Name="ImagesBox" DisplayMemberPath="ImageName"/><TextBlock Text="اضغط التالي لنسخ الإصدار إلى المشروع وتركيبه. في المسار القوي سيُحلل تلقائيًا لتعرض عليك التعديلات قبل تطبيقها."/>
  <Border x:Name="RecoveryPanel" Background="#442B22" Padding="12" Visibility="Collapsed"><StackPanel><TextBlock Text="جلسة متعثرة: الاستعادة تتجاهل التعديلات غير المحفوظة لهذا المشروع فقط."/><Button Content="استعادة الجلسة وتجاهل التعديلات غير المحفوظة" Click="RecoverImage"/></StackPanel></Border>
 </StackPanel></TabItem>
 <TabItem x:Name="CustomizeTab"><TabControl x:Name="CustomTabs"><TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ComponentsTab" Header="التخصيص · المكونات"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <DockPanel><Button Content="تحديث قائمة المكونات" Click="ReadInventory" DockPanel.Dock="Left" /><TextBlock Text="حدد عنصرًا ثم أضفه إلى الخطة. لا يُطبّق أي تغيير هنا." VerticalAlignment="Center" /></DockPanel>
   <TabControl x:Name="InventoryTabs" Grid.Row="1">
    <TabItem Header="الميزات"><DataGrid x:Name="FeaturesGrid" /></TabItem><TabItem Header="الحزم"><DataGrid x:Name="PackagesGrid" /></TabItem><TabItem Header="التعريفات"><DataGrid x:Name="DriversGrid" /></TabItem><TabItem Header="التطبيقات"><DataGrid x:Name="AppsGrid" /></TabItem><TabItem Header="الخدمات"><DataGrid x:Name="ServicesGrid" /></TabItem>
   </TabControl>
   <WrapPanel Grid.Row="2"><Button Content="تفعيل الميزة" Click="EnableFeature" /><Button Content="تعطيل الميزة" Click="DisableFeature" /><Button Content="إزالة العنصر المحدد" Click="RemoveSelected" /><ComboBox x:Name="ServiceStartBox" Width="170" SelectedIndex="1"><ComboBoxItem Content="تلقائي — 2" Tag="2" /><ComboBoxItem Content="يدوي — 3" Tag="3" /><ComboBoxItem Content="معطل — 4" Tag="4" /></ComboBox><Button Content="تغيير بدء الخدمة" Click="ChangeService" /></WrapPanel>
  </Grid></TabItem>
  <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="IntegrationTab" Header="التخصيص · الدمج"><StackPanel>
   <GroupBox Header="التحديثات وحزم اللغات والتعريفات"><StackPanel><TextBlock Text="CAB/MSU للتحديثات واللغات؛ INF لتعريفات الأجهزة الموقعة. يحدد DISM توافق الحزم مع الصورة." /><WrapPanel><Button Content="إضافة تحديثات أو حزم لغات" Click="AddPackages" /><Button Content="إضافة تعريف INF" Click="AddDrivers" /></WrapPanel></StackPanel></GroupBox>
   <GroupBox Header="تثبيت البرامج بعد تثبيت Windows"><StackPanel><TextBlock Text="يُنسخ EXE/MSI إلى الصورة، ويُشغّل عبر SetupComplete. لا يُشغّل البرنامج على جهازك أثناء التحرير. أدخل مفاتيح التثبيت الصامت الصحيحة من الناشر." /><DockPanel><Button Content="اختيار EXE/MSI" Click="BrowseInstaller" DockPanel.Dock="Left" /><TextBox x:Name="InstallerBox" /></DockPanel><TextBox x:Name="InstallerArgumentsBox" Text="/quiet /norestart" /><Button Content="إضافة البرنامج إلى الخطة" Click="StageInstaller" /></StackPanel></GroupBox>
  </StackPanel></TabItem>
  <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="RegistryTab" Header="التخصيص · التسجيل"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="تعديل سجل الصورة غير المتصلة"><StackPanel><TextBlock Text="المسارات نسبية إلى SOFTWARE أو SYSTEM داخل الصورة. لا تُعدّل هذه الواجهة سجل النظام المضيف." /><ComboBox x:Name="HiveBox" SelectedIndex="0"><ComboBoxItem Content="SOFTWARE" /><ComboBoxItem Content="SYSTEM" /></ComboBox><TextBlock Text="المفتاح" /><TextBox x:Name="RegistryKeyBox" /><TextBlock Text="اسم القيمة — فارغ للقيمة الافتراضية" /><TextBox x:Name="RegistryNameBox" /><ComboBox x:Name="RegistryTypeBox" /><TextBox x:Name="RegistryValueBox" AcceptsReturn="True" Height="65" /><Button Content="إضافة تعديل السجل للخطة" Click="AddRegistry" /></StackPanel></GroupBox>
   <GroupBox Header="Autounattend.xml دون كلمات مرور أو مفاتيح منتج"><StackPanel><TextBlock Text="اسم الكمبيوتر" /><TextBox x:Name="ComputerBox" Text="WINPC" /><TextBlock Text="لغة مثبتة في الصورة، مثل en-US أو ar-SA" /><TextBox x:Name="LanguageBox" Text="en-US" /><TextBlock Text="InputLocale" /><TextBox x:Name="InputLocaleBox" Text="0409:00000409" /><TextBlock Text="Windows time-zone ID" /><TextBox x:Name="TimeZoneBox" Text="UTC" /><ComboBox x:Name="ArchitectureBox" SelectedIndex="0"><ComboBoxItem Content="amd64" /><ComboBoxItem Content="arm64" /><ComboBoxItem Content="x86" /></ComboBox><Button Content="إضافة ملف الإجابة للخطة" Click="AddUnattend" /></StackPanel></GroupBox>
  </StackPanel></ScrollViewer></TabItem>
  
 <TabItem x:Name="StrongTab" Header="خطة التخفيف"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="110"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="يحافظ على المتجر والطباعة، ويختار إزالة Xbox وGame Pass وOneDrive والتطبيقات الإضافية المؤهلة." Foreground="#8FB8D9"/><WrapPanel><CheckBox x:Name="StrongDefenderBox" IsChecked="True" Content="فحص Defender القابل للإزالة" Checked="StrongOptionsChanged" Unchecked="StrongOptionsChanged"/><CheckBox x:Name="StrongLanguagesBox" IsChecked="True" Content="إبقاء العربية والإنجليزية ولغة الأساس" Checked="StrongOptionsChanged" Unchecked="StrongOptionsChanged"/></WrapPanel><TextBlock Text="المكونات المحمية قد تبقى ويُظهرها التقرير؛ لا تُضاف لغة غير مثبتة تلقائيًا." Foreground="#F5C778"/></StackPanel>
 <DataGrid Grid.Row="1" x:Name="StrongPreview" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="العملية" Binding="{Binding Kind}" Width="170"/><DataGridTextColumn Header="الهدف" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
 <TextBox Grid.Row="2" x:Name="StrongStatus" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft" Foreground="#F5C778"/>
 </Grid></TabItem></TabControl></TabItem>
 <TabItem x:Name="ReviewTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Expander Header="متقدم · تعديل الخطة أو حفظها" Foreground="#AAB7C8"><WrapPanel><Button Content="حذف الخطوة المحددة" Click="RemovePlan"/><Button Content="حفظ خطة JSON" Click="SavePlan"/><Button Content="تحميل خطة JSON" Click="LoadPlan"/></WrapPanel></Expander>
  <DataGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="1" x:Name="PlanGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="العملية" Binding="{Binding Kind}" Width="190" /><DataGridTextColumn Header="الهدف" Binding="{Binding Target}" Width="*" /><DataGridTextColumn Header="المعاملات" Binding="{Binding Arguments}" Width="170" /><DataGridTextColumn Header="سبب الاختيار" Binding="{Binding Reason}" Width="280" /></DataGrid.Columns></DataGrid>
   
  <TextBox Grid.Row="1" x:Name="ReviewResultBox" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto" Foreground="#B5E9D2"/>
  <StackPanel Grid.Row="2"><CheckBox x:Name="AcknowledgeBox" Content="راجعت الخطة وأوافق على تطبيقها، وسأختبر الناتج في جهاز افتراضي." Checked="WizardInputChanged" Unchecked="WizardInputChanged"/>
   <Expander Header="خيارات متقدمة · إلغاء الجلسة" Foreground="#AAB7C8"><Button Content="تجاهل التعديلات غير المحفوظة وإلغاء التركيب" Click="DiscardImage"/></Expander>
  </StackPanel>
 </Grid></TabItem>
 <TabItem x:Name="OutputTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock x:Name="OutputHint"/>
  <StackPanel x:Name="IsoSettings"><TextBlock Text="مكان حفظ ملف ISO النهائي · اختر اسمًا جديدًا"/><DockPanel><Button Content="اختيار مكان الحفظ" Click="BrowseOutput" DockPanel.Dock="Left"/><TextBox x:Name="OutputFileBox" TextChanged="WizardInputChanged"/></DockPanel>
   <TextBlock Text="أداة oscdimg.exe من Windows ADK · مطلوبة لبناء ISO"/><DockPanel><Button Content="اختيار الأداة" Click="BrowseOscdimg" DockPanel.Dock="Left"/><TextBox x:Name="OscdimgBox" TextChanged="WizardInputChanged"/></DockPanel><TextBlock Text="اضغط التالي لإنشاء ISO. قد تستغرق العملية وقتًا؛ سيظهر اكتمالها عند نجاح إنشاء الملف النهائي."/>
  </StackPanel>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem x:Name="DoneTab"><StackPanel Margin="16"><TextBlock Text="✓ اكتملت المهمة" FontSize="30" FontWeight="Bold" Foreground="#65D6A6"/><TextBlock Text="حُفظت الصورة النهائية. المسار:"/><TextBox x:Name="OutputPathBox" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="اختبر الإقلاع والطباعة والمتجر واللغات في جهاز افتراضي قبل تثبيت النسخة على جهازك."/><Button Content="بدء مشروع جديد" Click="NewProject"/></StackPanel></TabItem>
 </TabControl></Grid>
</DockPanel></Window>