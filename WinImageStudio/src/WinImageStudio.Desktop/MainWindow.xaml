<Window x:Class="WinImageStudio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinImageStudio — Windows Image Workshop" Width="1280" Height="900" MinWidth="980" MinHeight="700" FlowDirection="RightToLeft" Closing="WindowClosing" Background="#0D1117" Foreground="#EDF3FC" FontFamily="Segoe UI" FontSize="14">
<DockPanel Margin="16">
 <StackPanel DockPanel.Dock="Top">
  <DockPanel><TextBlock Text="WinImageStudio" FontSize="30" FontWeight="Bold"/><TextBlock Text="ورشة تخصيص صور Windows • إصدار هندسي 0.3.1" VerticalAlignment="Center"/></DockPanel>
  <TextBlock Text="المصدر يبقى محفوظًا • التعديل داخل المشروع • ثبّت الناتج في جهاز افتراضي قبل استخدامه" Foreground="#8FB8D9"/>
  <Border Background="#161B22" CornerRadius="8" Padding="10" Margin="0,8">
   <StackPanel><TextBlock x:Name="SessionLabel" Text="لا يوجد مشروع مفتوح"/><ProgressBar x:Name="Progress" Height="5" IsIndeterminate="False"/><DockPanel><Button x:Name="CancelButton" Content="إيقاف بعد الخطوة الحالية" Click="CancelClick" IsEnabled="False" DockPanel.Dock="Left"/><TextBlock x:Name="StatusLabel" Text="جاهز" VerticalAlignment="Center"/></DockPanel></StackPanel>
  </Border>
 </StackPanel>
 <TextBox DockPanel.Dock="Bottom" x:Name="LogBox" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
 <Border DockPanel.Dock="Top" Background="#161B22" CornerRadius="8" Padding="10" Margin="0,0,0,10"><StackPanel>
  <WrapPanel><TextBlock Text="اختر المسار:" VerticalAlignment="Center" FontWeight="Bold"/><RadioButton x:Name="StrongMode" GroupName="Mode" Content="التخفيف القوي · Pro" IsChecked="True" Checked="ModeChanged" Margin="12,8"/><RadioButton x:Name="ManualMode" GroupName="Mode" Content="التخصيص اليدوي" Checked="ModeChanged" Margin="12,8"/><Button Content="مسح الخطة لتغيير المسار" Click="ClearPlan"/></WrapPanel>
  <UniformGrid Columns="5"><Button x:Name="Step1" Content="① المصدر" Tag="1" Click="GoStep"/><Button x:Name="Step2" Content="② اختيار Pro وتركيبه" Tag="2" Click="GoStep"/><Button x:Name="Step3" Content="③ التعديلات" Tag="3" Click="GoStep"/><Button x:Name="Step4" Content="④ التطبيق والحفظ" Tag="4" Click="GoStep"/><Button x:Name="Step5" Content="⑤ إنشاء ISO" Tag="5" Click="GoStep"/></UniformGrid>
  <DockPanel><Button x:Name="NextButton" Content="التالي ←" Click="NextStep" DockPanel.Dock="Left"/><TextBlock x:Name="GuideText" Text="ابدأ باختيار ملف ISO ثم اضغط إنشاء المشروع." VerticalAlignment="Center" Foreground="#AAB7C8"/></DockPanel>
 </StackPanel></Border>
 <TabControl x:Name="EditorTabs">
  <TabItem x:Name="SourceTab" Header="① المصدر"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="مصدر النظام"><StackPanel><TextBlock Text="WIM / ESD / SWM / ISO"/><DockPanel><Button Content="اختيار ملف" Click="BrowseSource" DockPanel.Dock="Left"/><TextBox x:Name="SourceBox"/></DockPanel><TextBlock Text="مجلد المشاريع — يُنشأ مجلد جديد لكل مشروع"/><DockPanel><Button Content="اختيار مجلد" Click="BrowseWorkspace" DockPanel.Dock="Left"/><TextBox x:Name="WorkspaceBox"/></DockPanel><WrapPanel><Button Content="إنشاء مشروع وتحليل المصدر" Click="CreateProject"/><Button Content="فتح مشروع سابق" Click="OpenProject"/></WrapPanel></StackPanel></GroupBox>
   <GroupBox Header="الأدوات الخارجية"><StackPanel><TextBlock Text="oscdimg.exe من Windows ADK — مطلوب لبناء ISO"/><DockPanel><Button Content="اختيار" Click="BrowseOscdimg" DockPanel.Dock="Left"/><TextBox x:Name="OscdimgBox"/></DockPanel><TextBlock Text="wimlib-imagex.exe — مطلوب فقط لجمع أجزاء SWM"/><DockPanel><Button Content="اختيار" Click="BrowseWimlib" DockPanel.Dock="Left"/><TextBox x:Name="WimlibBox"/></DockPanel><Button Content="اعتماد مسارات الأدوات" Click="ApplyTools"/></StackPanel></GroupBox>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem x:Name="PrepareTab" Header="② الإصدار والتركيب"><StackPanel Margin="16"><TextBlock Text="اختر Windows Pro ثم اضغط تجهيز الصورة" FontSize="24" FontWeight="Bold"/><TextBlock Text="سيُنسخ الإصدار المختار إلى المشروع ثم يُركّب تلقائيًا. انتظر حتى تظهر علامة الإكمال."/><ComboBox x:Name="ImagesBox" DisplayMemberPath="ImageName"/><Button Content="② تجهيز الإصدار وتركيبه" Click="PrepareImage"/><TextBlock Text="إذا كانت جلسة سابقة قد فشلت، استخدم استعادة الجلسة أولًا؛ ستُتجاهل التعديلات غير المحفوظة." Foreground="#E8B86A"/><Button Content="استعادة الجلسة وتجاهل التعديلات غير المحفوظة" Click="RecoverImage"/></StackPanel></TabItem>
  <TabItem x:Name="ComponentsTab" Header="التخصيص · المكونات"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button Content="تحديث قائمة المكونات" Click="ReadInventory" DockPanel.Dock="Left"/><TextBlock Text="حدد عنصرًا ثم أضفه إلى الخطة. لا يُطبّق أي تغيير هنا." VerticalAlignment="Center"/></DockPanel>
   <TabControl x:Name="InventoryTabs" Grid.Row="1">
    <TabItem Header="الميزات"><DataGrid x:Name="FeaturesGrid"/></TabItem><TabItem Header="الحزم"><DataGrid x:Name="PackagesGrid"/></TabItem><TabItem Header="التعريفات"><DataGrid x:Name="DriversGrid"/></TabItem><TabItem Header="التطبيقات"><DataGrid x:Name="AppsGrid"/></TabItem><TabItem Header="الخدمات"><DataGrid x:Name="ServicesGrid"/></TabItem>
   </TabControl>
   <WrapPanel Grid.Row="2"><Button Content="تفعيل الميزة" Click="EnableFeature"/><Button Content="تعطيل الميزة" Click="DisableFeature"/><Button Content="إزالة العنصر المحدد" Click="RemoveSelected"/><ComboBox x:Name="ServiceStartBox" Width="170" SelectedIndex="1"><ComboBoxItem Content="تلقائي — 2" Tag="2"/><ComboBoxItem Content="يدوي — 3" Tag="3"/><ComboBoxItem Content="معطل — 4" Tag="4"/></ComboBox><Button Content="تغيير بدء الخدمة" Click="ChangeService"/></WrapPanel>
  </Grid></TabItem>
  <TabItem x:Name="IntegrationTab" Header="التخصيص · الدمج"><StackPanel>
   <GroupBox Header="التحديثات وحزم اللغات والتعريفات"><StackPanel><TextBlock Text="CAB/MSU للتحديثات واللغات؛ INF لتعريفات الأجهزة الموقعة. يحدد DISM توافق الحزم مع الصورة."/><WrapPanel><Button Content="إضافة تحديثات أو حزم لغات" Click="AddPackages"/><Button Content="إضافة تعريف INF" Click="AddDrivers"/></WrapPanel></StackPanel></GroupBox>
   <GroupBox Header="تثبيت البرامج بعد تثبيت Windows"><StackPanel><TextBlock Text="يُنسخ EXE/MSI إلى الصورة، ويُشغّل عبر SetupComplete. لا يُشغّل البرنامج على جهازك أثناء التحرير. أدخل مفاتيح التثبيت الصامت الصحيحة من الناشر."/><DockPanel><Button Content="اختيار EXE/MSI" Click="BrowseInstaller" DockPanel.Dock="Left"/><TextBox x:Name="InstallerBox"/></DockPanel><TextBox x:Name="InstallerArgumentsBox" Text="/quiet /norestart"/><Button Content="إضافة البرنامج إلى الخطة" Click="StageInstaller"/></StackPanel></GroupBox>
  </StackPanel></TabItem>
  <TabItem x:Name="RegistryTab" Header="التخصيص · التسجيل"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="تعديل سجل الصورة غير المتصلة"><StackPanel><TextBlock Text="المسارات نسبية إلى SOFTWARE أو SYSTEM داخل الصورة. لا تُعدّل هذه الواجهة سجل النظام المضيف."/><ComboBox x:Name="HiveBox" SelectedIndex="0"><ComboBoxItem Content="SOFTWARE"/><ComboBoxItem Content="SYSTEM"/></ComboBox><TextBlock Text="المفتاح"/><TextBox x:Name="RegistryKeyBox"/><TextBlock Text="اسم القيمة — فارغ للقيمة الافتراضية"/><TextBox x:Name="RegistryNameBox"/><ComboBox x:Name="RegistryTypeBox"/><TextBox x:Name="RegistryValueBox" AcceptsReturn="True" Height="65"/><Button Content="إضافة تعديل السجل للخطة" Click="AddRegistry"/></StackPanel></GroupBox>
   <GroupBox Header="Autounattend.xml دون كلمات مرور أو مفاتيح منتج"><StackPanel><TextBlock Text="اسم الكمبيوتر"/><TextBox x:Name="ComputerBox" Text="WINPC"/><TextBlock Text="لغة مثبتة في الصورة، مثل en-US أو ar-SA"/><TextBox x:Name="LanguageBox" Text="en-US"/><TextBlock Text="InputLocale"/><TextBox x:Name="InputLocaleBox" Text="0409:00000409"/><TextBlock Text="Windows time-zone ID"/><TextBox x:Name="TimeZoneBox" Text="UTC"/><ComboBox x:Name="ArchitectureBox" SelectedIndex="0"><ComboBoxItem Content="amd64"/><ComboBoxItem Content="arm64"/><ComboBoxItem Content="x86"/></ComboBox><Button Content="إضافة ملف الإجابة للخطة" Click="AddUnattend"/></StackPanel></GroupBox>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem x:Name="ReviewTab" Header="④ التطبيق والحفظ"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <WrapPanel><Button Content="حذف الخطوة المحددة" Click="RemovePlan"/><Button Content="حفظ الخطة JSON" Click="SavePlan"/><Button Content="تحميل خطة JSON" Click="LoadPlan"/></WrapPanel>
   <DataGrid Grid.Row="1" x:Name="PlanGrid" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="العملية" Binding="{Binding Kind}" Width="190"/><DataGridTextColumn Header="الهدف" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="المعاملات" Binding="{Binding Arguments}" Width="170"/><DataGridTextColumn Header="سبب الاختيار" Binding="{Binding Reason}" Width="280"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="2"><TextBox x:Name="ReviewResultBox" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="RightToLeft" MaxHeight="140" VerticalScrollBarVisibility="Auto" Foreground="#8FE1B5"/><CheckBox x:Name="AcknowledgeBox" Content="راجعت الخطة؛ أفهم أن إزالة مكونات قد تمنع الإقلاع أو التحديث، وسأختبر الناتج في جهاز افتراضي."/><WrapPanel><Button x:Name="ApplyPlanButton" Content="④ أ · تطبيق الخطة" Click="ApplyPlan"/><Button x:Name="ApproveNoChangesButton" Content="متابعة دون تعديلات · للخطة الفارغة" Click="ApproveNoChanges"/><Button x:Name="CommitButton" Content="④ ب · حفظ الصورة وإلغاء التركيب" Click="CommitImage"/><Button Content="تجاهل التعديلات وإلغاء التركيب" Click="DiscardImage"/><Button Content="استعادة الجلسة وتجاهل التعديلات" Click="RecoverImage"/></WrapPanel><TextBlock Text="إلغاء المهمة يُلاحظ بين الخطوات. العمليات المطبّقة لا تُعكس تلقائيًا؛ للتراجع عن جلسة غير محفوظة استخدم تجاهل التعديلات. تتطلب ISO ملفات تثبيت كاملة من مصدر ISO." Foreground="#8FB8D9"/></StackPanel>
  </Grid></TabItem>
  <TabItem x:Name="StrongTab" Header="③ التخفيف القوي"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="190"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="تخفيف قوي — Windows Pro فقط" FontSize="23" FontWeight="Bold"/>
    <TextBlock Text="ثابت: إبقاء Microsoft Store واعتمادياته والطباعة • إزالة Xbox وGame Pass وOneDrive والتطبيقات الإضافية المحددة" Foreground="#8FB8D9"/>
    <WrapPanel><CheckBox x:Name="StrongDefenderBox" IsChecked="True" Content="فحص إزالة مكونات Defender القابلة للإزالة"/><CheckBox x:Name="StrongLanguagesBox" IsChecked="True" Content="إزالة حزم اللغات الأخرى مع إبقاء العربية والإنجليزية ولغة الأساس اللازمة"/></WrapPanel>
    <TextBlock Text="مهم: Defender مدمج ومحمي في كثير من صور Pro. يُظهر التقرير ما سيبقى؛ لا حذف عشوائي لملفات النظام ولا ادعاء بأن التعطيل يساوي الإزالة. لا تُضاف لغة غير مثبتة تلقائيًا." Foreground="#F5C778"/>
    <WrapPanel><Button Content="تحليل الصورة وإنشاء خطة التخفيف" Click="AnalyzeStrong"/><Button Content="إضافة التخفيف إلى خطة التطبيق" Click="QueueStrong"/></WrapPanel>
   </StackPanel>
   <DataGrid Grid.Row="1" x:Name="StrongPreview" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="العملية" Binding="{Binding Kind}" Width="180"/><DataGridTextColumn Header="الهدف" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="سبب الاختيار" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid>
   <TextBox Grid.Row="2" x:Name="StrongStatus" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft" Foreground="#F5C778" Text="ركّب صورة Pro ثم حلّلها. الضغط على التحليل لا يحذف مكونات؛ التطبيق يكون من قسم الخطة والإخراج بعد مراجعة القائمة."/>
  </Grid></TabItem>
  <TabItem x:Name="OutputTab" Header="⑤ ملف ISO"><StackPanel Margin="16"><TextBlock Text="إنشاء النسخة النهائية" FontSize="24" FontWeight="Bold"/><TextBlock Text="بعد نجاح التطبيق والحفظ، اختر اسمًا جديدًا لملف ISO. يتطلب ذلك مصدر ISO كاملًا وأداة oscdimg من Windows ADK المحددة في الخطوة الأولى."/><Button x:Name="BuildIsoButton" Content="⑤ إنشاء ISO قابل للإقلاع" Click="BuildIso"/><TextBox x:Name="OutputPathBox" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="لن تظهر علامة ✓ حتى ينجح إنشاء الملف النهائي. اختبر الإقلاع والطباعة والمتجر في جهاز افتراضي قبل استخدام النسخة."/></StackPanel></TabItem>
 </TabControl>
</DockPanel></Window>
